# ─────────────────────────────────────────────────────────────
# Lift & Inspire — environment configuration
# Copy this file to ".env" and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Server port (optional, defaults to 3000)
PORT=3000

# ── Gmail (simplest option) ──
# Requires 2-Step Verification enabled on the Google account, then create an
# "App Password": https://myaccount.google.com/apppasswords
# Paste the 16-character password below (spaces are fine, they're stripped).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Where applications are delivered (optional; defaults to GMAIL_USER above)
APPLY_TO=youraddress@gmail.com

# Calendly link sent to applicants in the auto-reply email (so they can book
# their discovery call). Defaults to the one in the site if left unset.
# CALENDLY_URL=https://calendly.com/your-handle/30min

# ── Generic SMTP (alternative to Gmail) ──
# Leave the GMAIL_* vars blank and set these instead to use any SMTP provider.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your-smtp-password

# ── Database (Supabase / Postgres) ──
# Powers the blog and stores form submissions. Copy the connection string from
# Supabase: Project → Settings → Database → Connection string → URI.
# Use the "Transaction" pooler (port 6543) and add ?sslmode=require.
# Leave blank to run without a database (blog disabled, forms saved to file).
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres?sslmode=require

# ── Blog admin login ──
# Credentials for the /admin panel where blog posts are written.
# JWT_SECRET: any long random string (used to sign login sessions).
# ADMIN_EMAIL / ADMIN_PASSWORD: what you type on the /admin/login screen.
# JWT_SECRET=change-me-to-a-long-random-string
# ADMIN_EMAIL=you@email.com
# ADMIN_PASSWORD=a-strong-password

# ── Exercise demo GIFs (Giphy) ──
# Powers the auto GIF in the video modal (shown when an exercise has no linked
# video). Read at RUNTIME by the server, so setting it in your host's env vars
# (like DATABASE_URL) is enough — no client rebuild needed. Get a free API key
# at https://developers.giphy.com. Leave unset to disable (falls back to a
# YouTube search).
# GIPHY_KEY=your-giphy-api-key
