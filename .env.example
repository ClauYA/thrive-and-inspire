# ─────────────────────────────────────────────────────────────
# Thrive & Inspire — environment configuration
# Copy this file to ".env" and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Server port (optional, defaults to 3000)
PORT=3000

# ── Gmail (simplest option) ──
# Requires 2-Step Verification enabled on the Google account, then create an
# "App Password": https://myaccount.google.com/apppasswords
# Paste the 16-character password below (spaces are fine, they're stripped).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Where applications are delivered (optional; defaults to GMAIL_USER above)
APPLY_TO=youraddress@gmail.com

# ── Generic SMTP (alternative to Gmail) ──
# Leave the GMAIL_* vars blank and set these instead to use any SMTP provider.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your-smtp-password
